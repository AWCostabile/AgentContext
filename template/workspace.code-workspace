{
  "settings": {
    "files.exclude": {
      "**/.DS_Store": true,
      "**/.git": true,
      "**/.hg": true,
      "**/.svn": true,
      "**/Thumbs.db": true,

      // The following three may be toggled to `true` in order to hide them
      // from within VSCode, since they are effectively "system files", though
      // they'll still be tracked and committed via git.
      "**/.agent": false,
      "**/.index.md": false,
      "**/.tags": false
    }
  },
  "folders": [
    {
      "name": "Knowledge Tree",
      "path": "."
    },
    {
      "name": "Knowledge Tree (Private)",
      "path": "./private"
    },
    {
      "name": "{{REPOSITORY_NAME}}",
      "path": "../{{REPOSITORY_NAME}}"
    }
  ]
}
